Future<void> requestRefund(String paymentIntentId, String reason) async {
  final response = await http.post(
    Uri.parse("https://tu-api.com/api/payments/refund"),
    headers: {
      "Content-Type": "application/json",
    },
    body: jsonEncode({
      "PaymentIntentId": paymentIntentId,
      "Reason": reason,
    }),
  );

  final responseData = jsonDecode(response.body);

  if (response.statusCode == 200 && responseData["success"]) {
    print("Reembolso exitoso: ${responseData["refundId"]}");
  } else {
    print("Error en el reembolso: ${responseData["message"]}");
  }
}
